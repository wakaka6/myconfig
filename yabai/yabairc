#!/usr/bin/env sh

# i3-like defaults for macOS.
# Keyboard bindings live in ../skhd/skhdrc.

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config window_insertion_point focused
yabai -m config split_type auto
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

yabai -m config top_padding 8
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 10

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

yabai -m config window_shadow on
yabai -m config window_opacity off
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.95

# Keep system utility windows floating.
yabai -m rule --add role="^AXSheet$" manage=off
yabai -m rule --add subrole="^AXDialog$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^系统设置$" manage=off
yabai -m rule --add app="^System Information$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Dictionary$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^Keychain Access$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^Installer$" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add app="^Migration Assistant$" manage=off
yabai -m rule --add app="^Feedback Assistant$" manage=off
yabai -m rule --add app="^Screenshot$" manage=off
yabai -m rule --add app="^Image Capture$" manage=off
yabai -m rule --add app="^Digital Color Meter$" manage=off
yabai -m rule --add app="^ColorSync Utility$" manage=off
yabai -m rule --add app="^Bluetooth File Exchange$" manage=off

# Finder's main browser windows can tile; dialogs should float.
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Info|Preferences|Connect to Server|Go to Folder|Rename Finder Items|New Folder).*" manage=off
yabai -m rule --add app="^访达$" title="^(复制|移动|显示简介|偏好设置|连接服务器|前往文件夹|重新命名|新建文件夹).*" manage=off

# Menubar helpers and small utility windows.
yabai -m rule --add app="^Shadowrocket$" manage=off grid=8:8:2:1:4:6
yabai -m rule --add app="^CC Switch$" manage=off grid=8:8:2:1:4:6
yabai -m rule --add app="^Steam Helper$" manage=off
yabai -m rule --add app="^Eudic$" manage=off grid=8:8:1:1:6:6

# Password/authentication apps are usually awkward when tiled.
yabai -m rule --add app="^1Password$" manage=off grid=8:8:2:1:4:6
yabai -m rule --add app="^Bitwarden$" manage=off grid=8:8:2:1:4:6
yabai -m rule --add app="^KeePassXC$" manage=off grid=8:8:2:1:4:6
yabai -m rule --add app="^Passwords$" manage=off grid=8:8:2:1:4:6

# Chat apps stay tiled by default when they expose a normal resizable window;
# popups and apps that do not resize reliably are floated.
yabai -m rule --add app="^WeChat$" manage=off grid=8:8:1:1:6:6
yabai -m rule --add app="^(WeChat|Telegram|Discord|Feishu|飞书|Lark)$" title="^(Preferences|Settings|About|.*Call.*|.*Meeting.*|.*语音.*|.*视频.*|.*会议.*).*" manage=off

# Scratchpad-style apps. Toggle them from skhd with custom shortcuts if needed.
yabai -m rule --add app="^ChatGPT$" manage=off grid=8:8:1:1:6:6
yabai -m rule --add app="^iTerm2?$" title="^(translate|AItrans|ChatGPT)$" manage=off grid=8:8:1:1:6:6

echo "yabai configuration loaded"
